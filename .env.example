# AgriShield Rwanda - Environment Variables Example
# Duplicate this file as .env and populate with your own credentials

# Google Gemini API Key for AgriShield AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (generate a secure random string for production)
SECRET_KEY=django-insecure-change-this-to-a-secure-key-in-production

# Debug Mode (set False for production)
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,agrishieldrw.com,www.agrishieldrw.com

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://agrishieldrw.com,https://www.agrishieldrw.com,http://localhost:8000

